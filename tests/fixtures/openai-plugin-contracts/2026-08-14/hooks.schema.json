{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linw1995/lili/schemas/openai-plugin-hooks-2026-08-14.json",
  "title": "Lili OpenAI Plugin Hooks",
  "description": "Project-owned schema for the Lili subset of the OpenAI plugin hook contract reviewed on 2026-08-14.",
  "type": "object",
  "required": [
    "hooks"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hooks": {
      "type": "object",
      "required": [
        "SessionStart",
        "UserPromptSubmit",
        "PermissionRequest",
        "Stop",
        "SessionEnd"
      ],
      "properties": {
        "SessionStart": {
          "$ref": "#/$defs/groups"
        },
        "UserPromptSubmit": {
          "$ref": "#/$defs/groups"
        },
        "PermissionRequest": {
          "$ref": "#/$defs/groups"
        },
        "Stop": {
          "$ref": "#/$defs/groups"
        },
        "SessionEnd": {
          "$ref": "#/$defs/sessionEndGroups"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "handler": {
      "type": "object",
      "required": [
        "type",
        "command"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "commandWindows": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        },
        "statusMessage": {
          "type": "string",
          "minLength": 1
        },
        "async": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "sessionEndHandler": {
      "allOf": [
        {
          "$ref": "#/$defs/handler"
        },
        {
          "properties": {
            "timeout": {
              "maximum": 3
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "required": [
        "hooks"
      ],
      "properties": {
        "matcher": {
          "type": "string"
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/handler"
          }
        }
      },
      "additionalProperties": false
    },
    "sessionEndGroup": {
      "type": "object",
      "required": [
        "hooks"
      ],
      "properties": {
        "matcher": {
          "type": "string"
        },
        "hooks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sessionEndHandler"
          }
        }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "sessionEndGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sessionEndGroup"
      }
    }
  }
}
