{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lili",
  "version": "0.1.0",
  "identifier": "dev.linw1995.lili",
  "build": {
    "beforeDevCommand": "trunk build --locked",
    "beforeBuildCommand": "trunk build --locked --release",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist/": "web"
    },
    "icon": ["icons/icon.png"]
  }
}
